# --- General Configuration ---
PORT=3000
NODE_ENV=development

# --- S3-Compatible Cloud Storage Configurations ---
# Required for cloud offloading. Supported: AWS S3, Cloudflare R2, Google Cloud Storage, Backblaze B2, MinIO
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
S3_BUCKET_NAME=your-s3-bucket-name
S3_REGION=us-east-1

# Optional endpoint. Set this if you are using Cloudflare R2, Backblaze B2, MinIO, or custom S3 provider
# Example for Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=

# Force path style format (required for MinIO, LocalStack, and some S3-compatible providers)
# S3_FORCE_PATH_STYLE=false

# If set to true (highly recommended), uploaded downloads will be immediately deleted from Cloud Storage
# once streamed to the user. This keeps cloud storage footprint and cost at absolute zero.
DELETE_FROM_CLOUD_AFTER_DOWNLOAD=true

# --- API Rate Limiting Configurations ---
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes (in milliseconds)
RATE_LIMIT_MAX=150          # Max general API requests per IP in the window

DOWNLOAD_LIMIT_WINDOW_MS=3600000 # 1 hour (in milliseconds)
DOWNLOAD_LIMIT_MAX=20            # Max download and info lookups per IP in the window

# --- Proxy / Rotating Proxy Configurations ---
# Option 1: Single rotating proxy entry point (handles IP rotation internally, like smartproxy, oxylabs, etc.)
# Example: http://username:password@gate.proxyprovider.com:7000
PROXY_URL=

# Option 2: Comma-separated list of individual proxies (backend will pick a random one per request)
# Example: http://1.2.3.4:8080,http://username:password@5.6.7.8:1080
PROXY_LIST=

